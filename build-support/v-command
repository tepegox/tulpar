#!/bin/sh
# Keep the executable beside vlib: V derives its installation root from the
# real compiler path, while users get the conventional /usr/bin/v command.
# Defaults precede caller-supplied VFLAGS and command-line arguments so an
# explicit -os, -arch, -musl/-glibc, or -cc still wins. Alpine's native TCC is
# the fast default for applications and tells V it can link the Tulpar target.
# Keep V's worker passes serial until their threading is qualified on Tulpar.
# Require V3 and TCC for native builds; compiler failures must stay visible.
case "$(uname -m)" in
	x86_64) tulpar_arch=amd64 ;;
	*) tulpar_arch=arm64 ;;
esac
tulpar_vflags="-new-compiler -no-retry-compilation -os vinix -arch $tulpar_arch -musl -cc tcc -no-parallel -no-memory-limit"

# Keep the self-built compiler on the hosted Linux/musl runtime, while the
# resulting command continues to target Tulpar by default. Self-host serially
# with the same Alpine TCC so the replacement does not depend on Tulpar worker
# scheduling while compiler threading support is still being qualified.
for tulpar_arg in "$@"; do
	if [ "$tulpar_arg" = self ]; then
		tulpar_vflags="-new-compiler -no-retry-compilation -os linux -arch $tulpar_arch -musl -cc tcc -no-parallel -no-memory-limit"
		break
	fi
done
VJOBS=1
export VJOBS
if [ -n "${VFLAGS:-}" ]; then
	VFLAGS="$tulpar_vflags $VFLAGS"
else
	VFLAGS=$tulpar_vflags
fi
export VFLAGS
exec /usr/lib/vlang/v "$@"
